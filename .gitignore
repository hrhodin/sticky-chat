__pycache__/
*.pyc
build/
.venv/
.ruff_cache/
.coverage
.DS_Store

# Reference clone of upstream tmux, kept locally for reading the source.
# Not part of sticky-chat and not needed to run it.
tmux/
dist/
*.egg-info/
.pytest_cache/

# tmux -v debug logs, wherever they are run from
tmux-client-*.log
tmux-server-*.log

# Notes quote whatever was on screen. `sticky-chat --local` keeps them in
# the project rather than in ~/.sticky, so this is here for anyone who runs
# sticky on sticky - and for every clone of it.
.sticky/

# raw demo takes; only the chosen recording is committed
docs/takes/

# The recording toolchain and the working notes: kept on this machine, not
# in the published tree. `docs/record-demo.sh` and `docs/trim-cast.py` are
# what remade docs/demo-claude.gif, and the takes are what they were cut
# from.
docs/NOTES.md
docs/PLAN.md
docs/demo-agent.py
docs/demo-claude.cast
docs/demo-claude.tape
docs/demo-generic.gif
docs/demo-generic.tape
docs/pick.sh
docs/record-demo.sh
docs/relift.py
docs/repace.py
docs/trim-cast.py
docs/takes/
